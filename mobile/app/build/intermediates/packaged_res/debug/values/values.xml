<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#FFF4F2</color>
    <color name="onBackground">#49557E</color>
    <color name="onPrimary">#FFFFFF</color>
    <color name="onSecondary">#FFFFFF</color>
    <color name="onSurface">#49557E</color>
    <color name="primary">#49557E</color>
    <color name="primaryVariant">#3C4768</color>
    <color name="secondary">#FF6347</color>
    <color name="secondaryVariant">#E05A41</color>
    <color name="surface">#FFFFFF</color>
    <color name="surfaceVariant">#F9E8E3</color>
    <string name="app_name">CampusBites Mobile</string>
    <string name="email_hint">Email</string>
    <string name="first_name_hint">First Name</string>
    <string name="home_title">Welcome</string>
    <string name="last_name_hint">Last Name</string>
    <string name="login_button">Login</string>
    <string name="login_link">Already have an account? Log in</string>
    <string name="login_success">Login successful</string>
    <string name="login_title">Login</string>
    <string name="logout_button">Logout</string>
    <string name="password_hint">Password</string>
    <string name="register_button">Register</string>
    <string name="register_link">Create account</string>
    <string name="register_success">Registration completed. Please sign in.</string>
    <string name="register_title">Register</string>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/primaryVariant</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialButtonStyle">@style/Widget.App.MaterialButton</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout.OutlinedBox</item>
    </style>
    <style name="Widget.App.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/onSecondary</item>
    </style>
    <style name="Widget.App.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/secondary</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
</resources>