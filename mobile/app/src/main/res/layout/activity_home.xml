<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── NAVBAR ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/surface">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CampusBites"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/secondary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/navHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="home"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/navMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="menu"
                    android:textSize="14sp"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/navContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="contact us"
                    android:textSize="14sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <!-- Basket with dot -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/basketIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="20sp" />

                <View
                    android:id="@+id/basketDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/dot_indicator" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome!"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary" />

                <TextView
                    android:id="@+id/userInfoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="10sp"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign out"
                android:textSize="12sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- ── HERO BANNER ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/secondary"
            android:layout_margin="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Order your favorite food here"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/onSecondary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose from a diverse menu featuring a delectable array of dishes crafted with the finest ingredients and culinary expertise."
                    android:textSize="13sp"
                    android:textColor="@color/onSecondary"
                    android:alpha="0.85"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewMenuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Menu"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="50dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── EXPLORE MENU SECTION ── -->
        <LinearLayout
            android:id="@+id/exploreSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explore our menu"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/onBackground"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose from a diverse menu featuring a delectable array of dishes crafted with the finest ingredients."
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:alpha="0.7"
                android:layout_marginBottom="16dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Salad -->
                    <LinearLayout android:id="@+id/catSalad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salad" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Rolls -->
                    <LinearLayout android:id="@+id/catRolls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rolls" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Deserts -->
                    <LinearLayout android:id="@+id/catDeserts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deserts" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Sandwich -->
                    <LinearLayout android:id="@+id/catSandwich" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sandwich" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Cake -->
                    <LinearLayout android:id="@+id/catCake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cake" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Pure Veg -->
                    <LinearLayout android:id="@+id/catPureVeg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pure Veg" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Pasta -->
                    <LinearLayout android:id="@+id/catPasta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="20dp">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pasta" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                    <!-- Noodles -->
                    <LinearLayout android:id="@+id/catNoodles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/circle_outline" android:padding="4dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerCrop" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noodles" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="8dp" android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/surfaceVariant"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>